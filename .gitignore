# ===================================================
#   Live Assistant Git Ignore Configuration
# ===================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
develop-eggs/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/

# --- Virtual Environments (uv/venv) ---
.venv/
venv/
ENV/

# --- Heavy Assets (Downloaded at runtime) ---
# Ignore binary models and browser drivers to keep repo light
models/
ms-playwright/
*.tar.bz2
*.onnx

# --- Build Artifacts ---
build/
dist/
*.spec
# Ignore generated installers
直播助手_安装包_*.exe

# --- Project Specific Local Data ---
# Browser sessions and cookies
browser_session/
# Temporary data/logs
data/
*.log
.cache/

# --- Config & Secrets ---
.env
.env.local
.env.*
!.env.template

# --- Spreadsheets ---
# Ignore general xlsx, but allow template/default ones if they exist
*.xlsx
*.xls
!关键词回复规则.xlsx
!定时弹幕规则.xlsx

# --- OS Metadata ---
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini

# --- IDEs & Editors ---
.vscode/
.idea/
*.swp
*.swo
.project
.pydevproject
.settings/

# --- UV ---
# uv.lock is NOT ignored as it's critical for reproducible builds
# .python-version is NOT ignored for environment consistency
